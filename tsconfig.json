{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",

    // Enforce `import type` at the module boundary — pairs with ESLint rule
    "verbatimModuleSyntax": true,

    // Catch array/object index access that may be undefined
    "noUncheckedIndexedAccess": true,

    // Path aliases — mirrors the vite alias in astro.config.mjs
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
