---
import { DeviceWizard } from '@/components/wizard/DeviceWizard'
import BaseLayout from '@/layouts/BaseLayout.astro'

const templateId = Astro.url.searchParams.get('template')
---

<BaseLayout title="New Device">
  <div class="flex flex-col gap-6">
    <div>
      <a
        href="/"
        class="field-label inline-flex items-center gap-1 transition-colors hover:text-[var(--text-secondary)]"
        style="color: var(--text-muted); text-decoration: none;"
      >
        <svg
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          class="size-3"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 3 5 8l5 5"></path>
        </svg>
        Dashboard
      </a>
      <h1 class="mt-1 text-xl font-semibold tracking-tight" style="color: var(--text-primary);">
        New Device
      </h1>
    </div>

    <DeviceWizard client:load preloadTemplateId={templateId} />
  </div>
</BaseLayout>
