---
import { DeviceGrid } from '@/components/devices/DeviceGrid'
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout title="Dashboard">
  <div class="flex flex-col gap-6">
    <!-- Page header -->
    <div class="flex items-end justify-between">
      <div>
        <p class="field-label mb-1">control plane</p>
        <h1 class="text-xl font-semibold tracking-tight" style="color: var(--text-primary);">
          Devices
        </h1>
      </div>
      <!-- Realtime indicator -->
      <div class="flex items-center gap-1.5 pb-0.5">
        <span class="status-dot running" style="--dot-md: 6px;"></span>
        <span class="field-label">live · 5s</span>
      </div>
    </div>

    <!-- Device grid (React island) -->
    <DeviceGrid client:load />
  </div>
</BaseLayout>
